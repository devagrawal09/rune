+impl Env {
+    fn new() -> Self {
+        Env(None)
+    }
+    fn get(&self, name: &str) -> Option<&Value> {
+        let mut n = self.0.as_deref();
+        while let Some(x) = n {
+            if &*x.name == name {
+                return Some(&x.value);
+            }
+            n = x.next.as_deref();
+        }
