+    }
+    fn insert(&mut self, name: impl Into<Rc<str>>, value: Value) {
+        let next = self.0.take();
+        self.0 = Some(Rc::new(EnvNode {
+            name: name.into(),
+            value,
+            next,
+        }));
+    }
+}
+impl FromIterator<(String, Value)> for Env {
+    fn from_iter<I: IntoIterator<Item = (String, Value)>>(it: I) -> Self {
+        let mut env = Env::new();
+        for (k, v) in it {
